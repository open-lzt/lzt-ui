{
  "name": "@open-lzt/ui",
  "version": "0.1.0",
  "description": "LZT design system: a dependency-free CSS kit with dark/light tokens, an SVG icon sprite and typed React components",
  "license": "MIT",
  "keywords": [
    "ui",
    "design-system",
    "css",
    "css-framework",
    "react",
    "react-components",
    "typescript",
    "dark-mode",
    "icons",
    "forum",
    "dashboard",
    "open-lzt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-lzt/lzt-ui.git"
  },
  "homepage": "https://github.com/open-lzt/lzt-ui#readme",
  "bugs": {
    "url": "https://github.com/open-lzt/lzt-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lzt-ui.css": "./lzt-ui.css",
    "./lzt-ui.js": "./lzt-ui.js",
    "./lzt-icons.js": "./lzt-icons.js"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "lzt-ui.css",
    "lzt-ui.js",
    "lzt-icons.js"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsup": "^8.3.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  }
}
